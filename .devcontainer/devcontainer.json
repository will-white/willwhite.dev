// For format details, see https://aka.ms/devcontainer.json
{
  "name": "willwhite.dev",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5-24-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  // Persist Claude Code auth and settings across container rebuilds.
  "mounts": ["source=claude-code-config,target=/home/node/.claude,type=volume"],

  "forwardPorts": [3000],

  // Any pnpm will do: it switches itself to the version pinned in
  // package.json "packageManager" on first run.
  "postCreateCommand": "npm install -g pnpm && pnpm install",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
